# Supabase (required for products, catalogue, orders)
# Get these from: Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Airtable (order tracking sheet) — SERVER-SIDE ONLY (set in Netlify, not .env)
# 1. Create a base at airtable.com with a table named "Orders"
# 2. Get your Personal Access Token: airtable.com/create/tokens (scope: data.records:write)
# 3. Get Base ID from the URL: airtable.com/appXXXXXXXX/... → appXXXXXXXX is your Base ID
# These are read by the `create-order` and `list-orders` Netlify Functions. Do NOT prefix with VITE_.
AIRTABLE_TOKEN=your-airtable-personal-access-token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Orders

# Innofulfill / Shree Maruti (automatic COD order creation) — SERVER-SIDE ONLY (set in Netlify, not .env)
# 1. Log in to your Innofulfill account at app.innofulfill.com
# 2. Use the same email & password here for API authentication
# 3. Set INNOFULFILL_SANDBOX=true for the sandbox API, false for production
# 4. Fill in your pickup warehouse address details
# 5. Carrier ID and Carrier Name: get from Innofulfill dashboard or API docs
INNOFULFILL_USERNAME=your-innofulfill-login@email.com
INNOFULFILL_PASSWORD=your-innofulfill-password
INNOFULFILL_SANDBOX=false
INNOFULFILL_PICKUP_NAME=RetraLabs
INNOFULFILL_PICKUP_PHONE=9000000000
INNOFULFILL_PICKUP_ZIP=560001
INNOFULFILL_PICKUP_CITY=Bengaluru
INNOFULFILL_PICKUP_STATE=Karnataka
INNOFULFILL_PICKUP_ADDRESS=RetraLabs Warehouse, Bengaluru, Karnataka 560001
INNOFULFILL_CARRIER_ID=
INNOFULFILL_CARRIER_NAME=innofulfill_ecomm

# Telegram (instant mobile push on new order)
# 1. Message @BotFather on Telegram → /newbot → copy the token
# 2. Start your bot, then visit: https://api.telegram.org/bot<TOKEN>/getUpdates
#    Send any message to your bot first, then find "chat":{"id": XXXXXXX} — that's your Chat ID
VITE_TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
VITE_TELEGRAM_CHAT_ID=your-chat-id

# Brevo (transactional order-confirmation emails)
# 1. Get your API key: https://app.brevo.com/settings/keys/api
# 2. Create a transactional template and copy its numeric ID from the template list
# These are SERVER-SIDE ONLY — set them in Netlify (Site settings → Environment variables),
# never prefix with VITE_ or they will be exposed in the browser bundle.
BREVO_API_KEY=xsmtpsib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_TEMPLATE_ID=123

# Trustpilot (optional for reviews page)
# Get your Business ID from: https://businessapp.b2b.trustpilot.com/
# Navigate to Settings → Widgets to find your Business Unit ID
VITE_TRUSTPILOT_BUSINESS_ID=your-trustpilot-business-id
